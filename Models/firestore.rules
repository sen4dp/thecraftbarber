rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function owner() { return signedIn() && (me().role == 'dueno' || me().role == 'admin'); }
    function barber() { return signedIn() && me().role == 'barbero' && me().status == 'approved'; }
    function activeBarber(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role == 'barbero'
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'approved';
    }

    // Precios fijos de los servicios (deben coincidir con SERVICES en firebase-core.js).
    function priceFor(s) {
      return s == 'General' ? 18000
        : s == 'Barbería' ? 10000
        : s == 'General + Diseño' ? 20000
        : s == 'General + Barbería' ? 28000
        : s == 'General + Diseño + Barbería' ? 30000
        : -1;
    }
    function discountDoc(code) { return get(/databases/$(database)/documents/descuentos/$(code)).data; }
    function citaPriceOk(d) {
      return d.subtotal is int && d.total is int
        && d.subtotal == priceFor(d.servicio)
        && (!('descuentoCodigo' in d)
          ? d.total == d.subtotal
          : (discountDoc(d.descuentoCodigo).clienteId == request.auth.uid
            && discountDoc(d.descuentoCodigo).estado == 'activo'
            && discountDoc(d.descuentoCodigo).porcentaje == d.descuentoPct
            && d.total * 100 == d.subtotal * (100 - d.descuentoPct)));
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || owner());
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.role in ['usuario','barbero']
        && request.resource.data.status in ['approved','pending'];
      allow update: if owner()
        || (signedIn() && uid == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status);
      allow delete: if owner();
    }

    match /barberApplications/{uid} {
      allow read: if owner() || (signedIn() && uid == request.auth.uid);
      allow create: if signedIn() && uid == request.auth.uid;
      allow update, delete: if owner();
    }

    match /resenas/{id} {
      // Solo el Dueño lee el feedback. El documento no guarda identidad del cliente.
      allow read: if owner();
      allow create: if signedIn()
        && request.resource.data.barberId is string
        && activeBarber(request.resource.data.barberId)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 300;
      allow update, delete: if owner();
    }

    match /notas/{id} {
      allow read: if owner() || (barber() && resource.data.barberoId == request.auth.uid);
      allow create: if owner()
        && request.resource.data.creadoPor == request.auth.uid;
      allow update, delete: if owner();
    }

    match /promociones/{id} {
      allow read: if owner() || (signedIn() && resource.data.clienteId == request.auth.uid);
      allow create: if owner() && request.resource.data.creadoPor == request.auth.uid;
      allow update, delete: if owner();
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (uid == request.auth.uid || owner());
      allow delete: if signedIn() && (uid == request.auth.uid || owner());
    }

    match /citas/{id} {
      allow read: if owner() || (signedIn() && (
        resource.data.userId == request.auth.uid || resource.data.barberoId == request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && activeBarber(request.resource.data.barberoId)
        && request.resource.data.estado == 'reservada'
        && citaPriceOk(request.resource.data);
      allow update: if owner()
        || (barber() && resource.data.barberoId == request.auth.uid
          && request.resource.data.barberoId == resource.data.barberoId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','startedAt','finishedAt','cancelledAt','updatedAt','estadoPago','paidAt']))
        || (signedIn() && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.barberoId == resource.data.barberoId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','updatedAt'])
          && resource.data.estado == 'reservada'
          && request.resource.data.estado == 'cancelada');
      allow delete: if owner();
    }

    match /metodosPago/{uid} {
      allow read, write: if signedIn() && (uid == request.auth.uid || owner());
    }

    match /radicados/{code} {
      // El barbero solo ve y cobra los radicados de SUS citas; el dueño, todos.
      allow read: if owner() || (barber() && resource.data.barberoId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.estado == 'activo';
      // Solo Caja puede quemar un radicado; se exige transacción atómica con la cita y el pago.
      allow update: if (owner() || (barber() && resource.data.barberoId == request.auth.uid))
        && resource.data.estado == 'activo'
        && request.resource.data.estado == 'usado'
        && request.resource.data.citaId == resource.data.citaId
        && getAfter(/databases/$(database)/documents/transacciones/$(request.resource.data.citaId)).data.estado == 'Pago realizado con éxito'
        && getAfter(/databases/$(database)/documents/citas/$(resource.data.citaId)).data.estado in ['recibida','finalizada'];
      allow delete: if false;
    }

    match /transacciones/{id} {
      allow read: if owner() || barber();
      allow create: if (owner() || (barber()
          && getAfter(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data.barberoId == request.auth.uid))
        && request.resource.data.estado == 'Pago realizado con éxito'
        && request.resource.data.citaId is string
        && getAfter(/databases/$(database)/documents/radicados/$(request.resource.data.radicado)).data.estado == 'usado'
        && getAfter(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data.estado in ['recibida','finalizada'];
      allow update: if (owner() || (barber()
          && get(/databases/$(database)/documents/citas/$(resource.data.citaId)).data.barberoId == request.auth.uid))
        && resource.data.citaId == request.resource.data.citaId
        && request.resource.data.estado == 'Pago realizado con éxito';
      allow delete: if false;
    }

    // Aviso al admin: qué barbero cobró qué servicio (lo escribe Caja dentro de la misma transacción del pago).
    match /cobros/{citaId} {
      allow read: if owner() || (barber() && resource.data.cobradoPor == request.auth.uid);
      allow create: if barber()
        && request.resource.data.cobradoPor == request.auth.uid
        && request.resource.data.citaId == citaId
        && getAfter(/databases/$(database)/documents/citas/$(citaId)).data.barberoId == request.auth.uid
        && getAfter(/databases/$(database)/documents/citas/$(citaId)).data.estado in ['recibida','finalizada'];
      allow update, delete: if owner();
    }

    // Códigos de descuento generados por el admin para un cliente concreto (1 a 100 %).
    match /descuentos/{code} {
      allow read: if owner() || (signedIn() && resource.data.clienteId == request.auth.uid);
      allow create: if owner()
        && request.resource.data.codigo == code
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.estado == 'activo'
        && request.resource.data.clienteId is string
        && request.resource.data.porcentaje is int
        && request.resource.data.porcentaje >= 1
        && request.resource.data.porcentaje <= 100;
      // El cliente solo puede quemar SU código, y solo junto con la cita que lo usa (batch/transacción atómica).
      allow update: if owner()
        || (signedIn() && resource.data.clienteId == request.auth.uid
          && resource.data.estado == 'activo'
          && request.resource.data.estado == 'usado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','citaId','usadoAt'])
          && getAfter(/databases/$(database)/documents/citas/$(request.resource.data.citaId)).data.descuentoCodigo == code);
      allow delete: if owner();
    }
  }
}
